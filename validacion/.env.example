# Plantilla para validar cerrojo contra un proyecto Supabase de PRUEBAS.
#
# Todos los valores de este archivo son FICTICIOS. Para usarla:
#   cp validacion/.env.example validacion/.env
# y rellena validacion/.env. Ese archivo está en .gitignore: no lo subas ni lo compartas.
#
# Reglas:
#   · Solo un proyecto creado para esta validación, con datos sintéticos. Nunca producción.
#   · Solo la clave PÚBLICA (publishable). La clave secreta (sb_secret_… / service_role) no
#     hace falta para nada: no la copies aquí ni en ningún otro archivo.
#   · Solo las dos cuentas de prueba creadas para esto. Ninguna cuenta de una persona real.

# URL del proyecto de pruebas: Project Settings → Data API → Project URL.
# Tiene la forma https://<20 letras y números>.supabase.co
CERROJO_SUPABASE_URL=https://TU-REFERENCIA-DE-PROYECTO.supabase.co

# Clave pública: Project Settings → API Keys → Publishable key.
CERROJO_CLAVE=sb_publishable_PEGA_AQUI_LA_CLAVE_PUBLICA

# Cuentas de prueba. El correo debe contener "cerrojo-a@" y "cerrojo-b@".
# Usa contraseñas aleatorias creadas solo para esto; no reutilices ninguna tuya.
CERROJO_A_CORREO=cerrojo-a@example.test
CERROJO_A_CONTRASENA=cambia-esto-por-una-contrasena-aleatoria
CERROJO_B_CORREO=cerrojo-b@example.test
CERROJO_B_CONTRASENA=cambia-esto-por-otra-contrasena-aleatoria

# Confirmación. Rellénala a mano, en tu copia, solo cuando hayas comprobado que el proyecto
# es de pruebas y sus datos son sintéticos. El valor exacto está en validacion/GUION.md.
CERROJO_VALIDACION_CONFIRMO=

# Opcional: pon 1 si has hecho el paso de Storage (01b_storage_opcional.sql + subir archivos).
CERROJO_VALIDAR_STORAGE=0
